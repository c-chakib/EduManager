import NODE_ENV from 'dotenv';
import app from './server.js';
import { dbconnect } from './modeles/DBconnect.js';

NODE_ENV.config();
dbconnect();

const PORT = process.env.PORT || 3000;

if (process.env.NODE_ENV !== 'test') {
    app.listen(PORT, () => {
        console.log(`Server is running on port ${PORT}`);
    });
}
